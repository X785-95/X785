<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
    </style>

    <style name="bright" parent="AppTheme">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="colorPrimaryDark">#6D45CA</item>
        <item name="colorAccent">@color/AccentBright</item>
    </style>

    <style name = "dark" parent="AppTheme">
        <item name="colorPrimary">@color/colorDark</item>
        <item name="android:windowBackground">@color/backgroundDark</item>
        <item name="colorAccent">@color/AccentDark</item>
    </style>

    <style name = "retro" parent="AppTheme">
        <item name="colorPrimary">@color/colorRetro</item>
        <item name="android:windowBackground">@color/backgroundRetro</item>
        <item name="colorAccent">@color/AccentRetro</item>
    </style>

    <style name="ToolbarTheme" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="colorControlNormal">@android:color/white</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:textColorSecondary">@android:color/white</item>
    </style>


    <style name="NoteCardStyle">
        <item name="android:layout_margin">8dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/card_background</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="ButtonStyle">
        <item name="android:layout_margin">8dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:background">@color/background</item>
        <item name="android:textColor">@color/buttonTextColor</item>
        <item name="android:textSize">16sp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="RadioButtonStyle">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:padding">12dp</item>
    </style>

    <style name="EditTextStyle">
        <item name="android:minHeight">48dp</item>
        <item name="android:padding">12dp</item>
    </style>

</resources>